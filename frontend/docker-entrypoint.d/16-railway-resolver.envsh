#!/bin/sh

# Use the DNS server assigned to this container. This works in Docker Compose
# and Railway without hard-coding either platform's internal resolver address.
DNS_RESOLVER="$(awk '/^nameserver[[:space:]]+/ { print $2; exit }' /etc/resolv.conf)"
DNS_RESOLVER="${DNS_RESOLVER:-127.0.0.11}"

# Nginx requires IPv6 resolver addresses to be enclosed in square brackets.
case "$DNS_RESOLVER" in
    *:*) DNS_RESOLVER="[$DNS_RESOLVER]" ;;
esac

export DNS_RESOLVER
